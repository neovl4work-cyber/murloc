<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        The plugin apk is a separately installed app, so it can host its own components:
        - FolderPickActivity shows the system folder picker (ACTION_OPEN_DOCUMENT_TREE) and
          is started from the plugin core, which is executed in the Murglar host process
          (see AndroidFolderPicker in murloc-core);
        - PickResultProvider passes the picked folder back to the plugin core (the host process
          polls it after launching the picker).
    -->
    <application>
        <activity
            android:name=".FolderPickActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <provider
            android:name=".PickResultProvider"
            android:authorities="com.badmanners.murglar.plugin.local.provider"
            android:exported="true" />
    </application>
</manifest>
